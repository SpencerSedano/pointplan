rules_version = '2';

// PointPlan security rules.
// A trip can be read and edited only by the Google accounts listed in its `editors`.
// Only the trip's owner can invite or remove people or delete the trip; anyone else can leave it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function isEditor(trip) { return signedIn() && me() in trip.editors; }
    function isOwner(trip) { return signedIn() && trip.owner == request.auth.uid; }
    function validEditors(t) { return t.editors is list && t.editors.size() >= 1 && t.editors.size() <= 20; }

    match /trips/{tripId} {
      allow read: if isEditor(resource.data);

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && validEditors(request.resource.data)
        && me() in request.resource.data.editors;

      allow update: if isEditor(resource.data)
        && request.resource.data.owner == resource.data.owner
        && validEditors(request.resource.data)
        && (
          // the owner can change who has access
          isOwner(resource.data)
          // everyone else edits the trip without touching who has access...
          || request.resource.data.editors == resource.data.editors
          // ...or removes only themselves (leave the trip)
          || request.resource.data.editors == resource.data.editors.removeAll([me()])
        );

      allow delete: if isOwner(resource.data);

      match /items/{itemId} {
        allow read, write: if isEditor(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }
  }
}
